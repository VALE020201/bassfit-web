# 1. URL Pública del Frontend (Dominio .com priorizado en Namecheap / Hostinger)
NEXT_PUBLIC_SITE_URL="https://www.bassfit.com"

# 2. Conexión Headless con WordPress + WooCommerce REST API v3 & WPGraphQL
NEXT_PUBLIC_WORDPRESS_URL="https://cms.bassfit.com"
WC_CONSUMER_KEY="ck_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
WC_CONSUMER_SECRET="cs_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
WORDPRESS_WEBHOOK_SECRET="whsec_bassfit_revalidate_2026"

# 3. Pasarela de Pagos Easy Pay (Flujo de Compra Directa: Implementos y Accesorios)
EASYPAY_API_URL="https://api.easypay.pe/v1"
EASYPAY_MERCHANT_ID="merchant_bassfit_prod"
EASYPAY_SECRET_KEY="ep_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
EASYPAY_WEBHOOK_SECRET="ep_whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# 4. Canal de Venta Consultiva (Flujo Suplementos y Asesorías de Entrenamiento)
NEXT_PUBLIC_WHATSAPP_ADVISOR_PHONE="51999888777"
NEXT_PUBLIC_WHATSAPP_COACH_PHONE="51999888777"

